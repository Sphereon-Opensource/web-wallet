{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "oneOf": [
        {"const": "eInvoice", "title": "eInvoicing"},
        {"const": "linkedDomains", "title": "Linked domains"},
        {"const": "didCommMessaging", "title": "DIDComm messaging"},
        {"const": "credentialRegistry", "title": "Credential registry"},
        {"const": "openID4VCI", "title": "OpenID for verifiable credential issuance"},
        {"const": "openID4VP", "title": "OpenID for verifiable presentation"}
      ]
    },
    "eInvoiceMethod": {
      "type": "string",
      "title": "eInvoicing Network",
      "description": "The eInvoicing network type",
      "oneOf": [
        {"const": "Direct", "title": "Direct (HTTP)"},
        {"const": "Peppol", "title": "Peppol"},
        {"const": "PPF-FR", "title": "France PPF"}
      ]
    },
    "id": {
      "type": "string"
    },
    "serviceEndpoint": {
      "type": "string"
    },
    "entityName": {
      "type": "string",
      "title": "Entity Name",
      "description": "The name of the entity operating this eInvoicing channel"
    },
    "country": {
      "type": "string",
      "title": "Country",
      "description": "ISO 3166-1 alpha-2 country code (e.g., NL, FR, DE)",
      "pattern": "^[A-Za-z]{2}$",
      "minLength": 2,
      "maxLength": 2
    },
    "inboxName": {
      "type": "string",
      "title": "Inbox Name",
      "description": "Name of the inbox to receive invoices (default: einvoices)",
      "default": "einvoices"
    },
    "folderName": {
      "type": "string",
      "title": "Folder Name",
      "description": "Name of the folder within the inbox (default: service ID)"
    },
    "peppolParticipantId": {
      "type": "string",
      "title": "PEPPOL Participant ID",
      "description": "PEPPOL Participant Identifier (e.g., iso6523-actorid-upis::0106:123456789)"
    },
    "peppolSmpUrl": {
      "type": "string",
      "title": "PEPPOL SMP URL",
      "description": "URL of the organisation's PEPPOL SMP record (optional)"
    },
    "peppolAs4Endpoint": {
      "type": "string",
      "title": "PEPPOL AS4 Endpoint",
      "description": "AS4 endpoint URL of the Access Point (optional)"
    },
    "ppfPlatformId": {
      "type": "string",
      "title": "PPF Platform ID",
      "description": "Identifier on the French PPF (e.g., fr-ppf:pdp:provider-123)"
    },
    "ppfRecipientIds": {
      "type": "string",
      "title": "PPF Recipient IDs",
      "description": "Recipient identifiers (SIREN/SIRET), comma-separated"
    },
    "ppfMode": {
      "type": "string",
      "title": "PPF Mode",
      "description": "Connection mode on the French PPF",
      "oneOf": [
        {"const": "pdp", "title": "PDP (Plateforme de Dématérialisation Partenaire)"},
        {"const": "direct", "title": "Direct connection"},
        {"const": "via-pdp", "title": "Via PDP"}
      ]
    },
    "ppfApiEndpoint": {
      "type": "string",
      "title": "PPF API Endpoint",
      "description": "API endpoint for PPF connection (optional)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {"enum": ["linkedDomains", "didCommMessaging", "credentialRegistry", "openID4VCI", "openID4VP"]}
        },
        "required": ["type"]
      },
      "then": {
        "required": ["serviceEndpoint"]
      },
      "else": {}
    },
    {
      "if": {
        "properties": {
          "type": {"const": "eInvoice"}
        },
        "required": ["type"]
      },
      "then": {
        "required": ["eInvoiceMethod", "entityName", "country"]
      },
      "else": {}
    },
    {
      "if": {
        "properties": {
          "type": {"const": "eInvoice"},
          "eInvoiceMethod": {"const": "Peppol"}
        },
        "required": ["type", "eInvoiceMethod"]
      },
      "then": {
        "required": ["peppolParticipantId"]
      },
      "else": {}
    },
    {
      "if": {
        "properties": {
          "type": {"const": "eInvoice"},
          "eInvoiceMethod": {"const": "PPF-FR"}
        },
        "required": ["type", "eInvoiceMethod"]
      },
      "then": {
        "required": ["ppfPlatformId", "ppfRecipientIds", "ppfMode"]
      },
      "else": {}
    }
  ],
  "required": ["type", "id"]
}
