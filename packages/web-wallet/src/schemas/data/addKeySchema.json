{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "oneOf": [
        {
          "const": "generate",
          "title": "Generate new key"
        },
        {
          "const": "select",
          "title": "Select existing key"
        }
      ],
      "default": "generate"
    },
    "type": {
      "type": "string",
      "oneOf": [
        {
          "const": "Secp256r1",
          "title": "ES256 (Secp256r1)"
        },
        {
          "const": "Secp256k1",
          "title": "ES256k1 (Secp256k1)"
        },
        {
          "const": "Ed25519",
          "title": "Ed25519"
        },
        {
          "const": "RSA",
          "title": "RSA"
        }
      ]
    },
    "alias": {
      "type": "string"
    },
    "selectedKeyId": {
      "type": "string",
      "title": "Key"
    },
    "purposes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "const": "authentication",
            "title": "Authentication"
          },
          {
            "const": "assertionMethod",
            "title": "Assertion Method"
          },
          {
            "const": "capabilityInvocation",
            "title": "Capability Invocation"
          },
          {
            "const": "capabilityDelegation",
            "title": "Capability Delegation"
          },
          {
            "const": "keyAgreement",
            "title": "Key Agreement"
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["action"],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": { "const": "generate" }
        }
      },
      "then": {
  "required": ["type", "purposes"]
}
    },
    {
      "if": {
        "properties": {
          "action": { "const": "select" }
        }
      },
      "then": {
        "required": ["selectedKeyId"]
      }
    }
  ]
}