{
  "type":"VerticalLayout",
  "elements":[
    {
      "type": "Group",
      "label": "Choose images",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/background_image/properties/uri",
          "label": "Background URL"
        },
        {
          "type": "Control",
          "scope": "#/properties/logo/properties/uri",
          "label": "Logo URL"
        }
      ]
    },
    {
      "type": "Group",
      "label": "Choose colors",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/background_color",
          "options": {
            "type": "color-picker"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/text_color",
          "options": {
            "type": "color-picker"
          }
        }
      ]
    }
  ]
}
