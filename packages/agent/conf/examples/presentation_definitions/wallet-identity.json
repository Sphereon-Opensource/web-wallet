{
  "id": "wallet-identity",
  "name": "Wallet details",
  "purpose": "We need to verify your name",
  "format": {
    "vc+sd-jwt": {
      "sd-jwt_alg_values": [
        "ES256",
        "ES384",
        "ES512",
        "EdDSA"
      ]
    }
  },
  "input_descriptors": [
    {
      "id": "e5d97b9a-d9cd-416e-9d08-1da46145a4b5",
      "constraints": {
        "limit_disclosure": "preferred",
        "fields": [
          {
            "path": [
              "$.firstName"
            ]
          },
          {
            "path": [
              "$.lastName"
            ]
          },
          {
            "path": [
              "$.iat"
            ]
          },
          {
            "path": [
              "$.vct"
            ],
            "filter": {
              "type": "string",
              "pattern": "SphereonWalletIdentityCredential"
            }
          }
        ]
      },
      "name": "Sphereon Wallet",
      "purpose": "We need to verify your first and lastname from the Sphereon Wallet."
    }
  ]
}
