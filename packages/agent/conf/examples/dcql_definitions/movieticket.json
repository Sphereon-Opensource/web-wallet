{
  "queryId": "MovieTicket",
  "name": "Movie ticket",
  "defaultPurpose": "We need to verify your movie tickets.",
  "query": {
    "credentials": [
      {
        "id": "movie-ticket",
        "format": "dc+sd-jwt",
        "require_cryptographic_holder_binding": true,
        "multiple": false,
        "meta": {
          "vct_values": [
            "MovieTicket"
          ]
        },
        "claims": [
          {
            "path": [
              "MovieTicket",
              "movieName"
            ]
          },
          {
            "path": [
              "MovieTicket",
              "date"
            ]
          },
          {
            "path": [
              "MovieTicket",
              "starTime"
            ]
          },
          {
            "path": [
              "MovieTicket",
              "seats"
            ]
          },
          {
            "path": [
              "MovieTicket",
              "VIP"
            ]
          }
        ]
      }
    ]
  }
}
