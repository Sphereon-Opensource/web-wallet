{
  "queryId": "Employee",
  "name": "Employee details",
  "defaultPurpose": "We need to verify your employee id.",
  "query": {
    "credentials": [
      {
        "id": "employee-id",
        "format": "dc+sd-jwt",
        "require_cryptographic_holder_binding": true,
        "multiple": false,
        "meta": {
          "vct_values": [
            "Employee"
          ]
        },
        "claims": [
          {
            "path": [
              "Employee",
              "employeeNumber"
            ]
          }
        ]
      }
    ]
  }
}
