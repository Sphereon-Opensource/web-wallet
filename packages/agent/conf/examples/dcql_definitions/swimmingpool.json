{
  "queryId": "Swimmingpool",
  "name": "Swimmingpool reservation",
  "defaultPurpose": "We need to verify your swimming pool reservation.",
  "query": {
    "credentials": [
      {
        "id": "swimming-pool",
        "format": "dc+sd-jwt",
        "require_cryptographic_holder_binding": true,
        "multiple": false,
        "meta": {
          "vct_values": ["Swimmingpool"]
        },
        "claims": [
          {
            "path": ["General", "date"]
          },
          {
            "path": ["Pax", "Adults"]
          },
          {
            "path": ["Pax", "Children"]
          }
        ]
      }
    ]
  }
}
