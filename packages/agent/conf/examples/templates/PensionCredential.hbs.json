{
  "@context": [
    "https://pensiondemo.findy.fi/pensioncredential-schema/pensionvocabulary-v010.html",
    "https://www.w3.org/2018/credentials/v1",
    {
      "description": {
        "@id": "http://schema.org/description",
        "@container": "@language"
      }
    }
  ],
  "type": [
    "VerifiableCredential",
    "PensionCredential"
  ],
  "expirationDate": "{{{ dateTimeAfterMonths 12 }}}",
  "id": "PensionCredential",
  "credentialSubject": {
    "Pension": {
      "startDate": "{{startDate}}",
      "endDate": "{{endDate}}",
      "provisional": "{{provisional}}",
      "typeCode": "{{typeCode}}",
      "typeName": "{{typeName}}"
    },
    "Person": {
      "personal_administrative_number": "{{personalAdministrativeNumber}}",
      "birth_date": "{{birthDate}}",
      "family_name": "{{familyName}}",
      "given_name": "{{givenName}}"
    }
  },
  "credentialStatus": {
    "type": "StatusList2021"
  }
}
