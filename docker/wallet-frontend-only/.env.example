NODE_ENV=development

# OIDC Configuration
OIDC_ISSUER=https://your-auth-server.example.com/auth/realms/your-realm
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

OIDC_PROFILE_IMAGE=https://example.com/path/to/profile-image.jpg

# NextAuth Configuration
NEXTAUTH_ENABLED=false
NEXTAUTH_URL=https://your-wallet-domain.com/
BROWSER_PUBLIC_API_BASE_URL=https://your-wallet-domain.com/api
BROWSER_PUBLIC_API_URL=https://your-wallet-domain.com/api

# Supabase Configuration (optional - commented out examples)
# BROWSER_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# BROWSER_PUBLIC_SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# BROWSER_PUBLIC_SUPABASE_DB_SCHEMA=your_schema
# BROWSER_PUBLIC_SUPABASE_STORAGE_SCHEMA=your_storage_schema
# SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_ANON_KEY=your-anon-key

# Agent and Data Provider Configuration
BROWSER_PUBLIC_DATA_PROVIDER_BASE_URL=https://your-agent-domain.com
BROWSER_PUBLIC_AGENT_BASE_URL=https://your-agent-domain.com

# VC API Configuration
BROWSER_PUBLIC_VC_API_BASE_PATH=/vc
BROWSER_PUBLIC_W3C_VC_API_GET_CREDENTIAL_URL=https://your-agent-domain.com/vc/credentials

# Temporary Credential Configuration (for testing/demo)
BROWSER_PUBLIC_TEMP_CREDENTIAL_TITLE=Example Title
BROWSER_PUBLIC_TEMP_CREDENTIAL_SUBTITLE=Example Subtitle
BROWSER_PUBLIC_TEMP_CREDENTIAL_LOGO=http://localhost:5001/images/card_logo.png
BROWSER_PUBLIC_TEMP_CREDENTIAL_BACKGROUND_IMAGE=http://localhost:5001/images/card_background.png
BROWSER_PUBLIC_TEMP_CREDENTIAL_STATUS=valid
BROWSER_PUBLIC_TEMP_CREDENTIAL_ISSUER_NAME=Example Issuer

# DID Configuration - Use your own DIDs
# These are example DIDs for different roles in your system
BROWSER_PUBLIC_PROCESS_OWNER_DID=did:ion:your-process-owner-did
BROWSER_PUBLIC_SUPPLIER_DID=did:ion:your-supplier-did
BROWSER_PUBLIC_TESTER_DID=did:ion:your-tester-did
